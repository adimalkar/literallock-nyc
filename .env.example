# ==============================================================================
# LiteralLock Environment Configuration
# ==============================================================================

# Mistral AI Credentials
# Obtain from https://console.mistral.ai or event organizers
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_CHAT_MODEL=mistral-large-latest
MISTRAL_EMBED_MODEL=mistral-embed

# Elasticsearch Credentials
# ELASTICSEARCH_URL can be your Elastic Cloud endpoint or local cluster (e.g., https://localhost:9200)
# If using Elastic Cloud, you can use ELASTICSEARCH_URL or ELASTIC_CLOUD_ID
ELASTICSEARCH_URL=https://your-elastic-deployment-url:9200
ELASTICSEARCH_API_KEY=your_elastic_api_key_here
# ELASTIC_CLOUD_ID=

# Application & Index Settings
ELASTICSEARCH_INDEX=literallock_nyc_inspections
# SEMANTIC_BACKEND: 'semantic_text' (preferred if inference endpoint available) or 'dense_vector'
SEMANTIC_BACKEND=semantic_text
# Mistral text_embedding endpoint (service "mistral", model mistral-embed, 1024 dims) used by semantic_text
ELASTIC_INFERENCE_ID=literallock-embeddings

# Decision Backend: 'rules' (default) or 'laya' (optional spare-time route)
DECISION_BACKEND=rules
# LAYA_CHECKPOINT=convaiinnovations/laya-typed-decisions
# LAYA_REVISION=
